{
  "project_name": "Merinos Dense Retrieval & Re-ranking Engine",
  "version": "1.0.0",
  "bi_encoder": {
    "model_name": "all-MiniLM-L6-v2",
    "embedding_dimension": 384,
    "max_seq_length": 256,
    "normalize_embeddings": true,
    "batch_size": 32,
    "device": "cpu"
  },
  "vector_store": {
    "collection_name": "merinos_technical_docs",
    "distance": "Cosine",
    "in_memory": true,
    "hnsw_config": {
      "m": 16,
      "ef_construct": 100
    }
  },
  "cross_encoder": {
    "model_name": "cross-encoder/ms-marco-TinyBERT-L-2-v2",
    "max_seq_length": 256,
    "apply_sigmoid": true,
    "batch_size": 16,
    "device": "cpu"
  },
  "pipeline": {
    "first_stage_top_k": 10,
    "final_top_k": 3
  },
  "corpus_file": "mini_project/fixtures/merinos_technical_corpus.json",
  "output_dir": "mini_project/outputs"
}
