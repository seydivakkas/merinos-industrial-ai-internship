  },
  "grabcut": {
    "iterations": 5,
    "margin_fraction": 0.08,
    "gmm_components": 5
  },
  "evaluation": {
    "min_acceptable_iou": 0.70,
    "min_acceptable_dice": 0.80,
    "boundary_tolerance_px": 2
  },
  "benchmark": {
    "iterations_per_algorithm": 15,
    "resolutions": [
      [512, 512],
      [1024, 1024],
      [2048, 2048]
    ]
  }
