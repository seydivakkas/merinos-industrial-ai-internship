{
  "otsu": {
    "gaussian_blur_ksize": [5, 5],
    "gaussian_sigma": 1.2,
    "multi_level_classes": 3,
    "morphological_cleanup": {
      "apply": true,
      "ksize": [3, 3]
    }
  },
  "watershed": {
    "distance_transform_threshold_ratio": 0.45,
