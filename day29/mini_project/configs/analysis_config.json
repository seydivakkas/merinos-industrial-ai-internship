{
  "project": "Merinos Halı Sanayi ve Ticaret A.Ş.",
  "module": "Day 29 — Üretilen Halı Görsellerinin Analizi",
  "curriculum": "Staj Defteri Yaprak 57 ve 58",
  "kmeans": {
    "num_clusters": 5,
    "max_iter": 100,
    "random_state": 42,
    "resize_dim": [256, 256]
  },
  "color_metrics": {
    "cielab_formula": "CIEDE2000",
    "delta_e_thresholds": {
      "imperceptible": 1.0,
      "close_match": 3.0,
      "noticeable_difference": 6.0
    }
  },
  "symmetry": {
    "modes": ["horizontal", "vertical", "repeat_autocorrelation"],
    "blur_kernel_size": 5
  },
  "seam_continuity": {
    "strip_width_pixels": 8,
    "acceptable_mse_threshold": 1200.0,
    "sobel_gradient_weight": 0.3
  },
  "cnn_embedding": {
    "backbone": "resnet18_simulated",
    "embedding_dim": 512,
    "metric": "cosine",
    "default_top_k": 3
  }
}
