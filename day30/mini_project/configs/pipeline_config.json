{
  "pipeline_name": "Merinos Integrated Carpet Generation & Analysis Engine",
  "version": "1.0.0",
  "generation": {
    "model": "sdxl",
    "steps": 30,
    "guidance_scale": 7.5
  },
  "default_resolution": [512, 512],
  "default_seed": 42,
  "kmeans": {
    "num_clusters": 5,
    "max_iter": 100,
    "random_state": 42
  },
  "ciede2000": {
    "target_tolerance_delta_e": 5.0,
    "warning_tolerance_delta_e": 8.0
  },
  "symmetry": {
    "min_acceptable_score": 0.70,
    "perfect_threshold": 0.90
  },
  "seam_continuity": {
    "max_boundary_jump_pct": 12.0,
    "boundary_strip_width_px": 8
  },
  "similarity": {
    "embedding_dim": 512,
    "top_k": 3,
    "similarity_threshold": 0.65
  },
  "visualizer": {
    "dpi": 300,
    "figsize": [18, 14],
    "style": "seaborn-v0_8-whitegrid"
  }
}
