{
  "dataset": {
    "n_samples": 3000,
    "test_size": 0.20,
    "random_state": 42
  },
  "models": {
    "linear": {
      "C": 1.0,
      "kernel": "linear",
      "probability": true,
      "random_state": 42
    },
    "polynomial": {
      "C": 1.0,
      "kernel": "poly",
      "degree": 3,
      "coef0": 1.0,
      "probability": true,
      "random_state": 42
    },
    "rbf": {
      "C": 10.0,
      "kernel": "rbf",
      "gamma": "scale",
      "probability": true,
      "random_state": 42
    }
  },
  "grid_search": {
    "C_values": [0.1, 1.0, 10.0, 100.0],
    "gamma_values": [0.001, 0.01, 0.1, 1.0],
    "cv_folds": 3
  },
  "output_paths": {
    "dataset_csv": "day20/mini_project/fixtures/carpet_defect_svm_dataset.csv",
    "master_report_json": "day20/mini_project/outputs/svm_master_report.json",
    "diagnostic_panel_png": "day20/mini_project/outputs/svm_diagnostic_panel.png"
  }
}
