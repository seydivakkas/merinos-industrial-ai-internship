{
  "edge_operators": {
    "gaussian_blur": {
      "ksize": [5, 5],
      "sigma": 1.2
    },
    "sobel": {
      "ksize": 3,
      "scale": 1.0,
      "delta": 0.0
    },
    "scharr": {
      "scale": 1.0,
      "delta": 0.0
    },
    "laplacian": {
      "ksize": 3,
      "scale": 1.0,
      "delta": 0.0
    },
    "canny": {
      "low_threshold": 50,
      "high_threshold": 150,
      "aperture_size": 3,
      "l2_gradient": true
    }
  },
  "hough_transform": {
    "rho": 1.0,
    "theta_degrees": 1.0,
    "threshold": 40,
    "min_line_length": 60,
    "max_line_gap": 15
  },
  "border_analysis": {
    "margin_fraction": 0.22,
    "angle_tolerance_horizontal_deg": 15.0,
    "angle_tolerance_vertical_deg": 15.0,
    "parallelism_tolerance_deg": 0.50,
    "orthogonality_tolerance_deg": 0.75,
    "max_width_variance_px": 4.0,
    "max_straightness_rms_px": 2.5
  },
  "quality_decision_rules": {
    "accept": {
      "max_parallelism_deviation_deg": 0.50,
      "max_orthogonality_deviation_deg": 0.75,
      "max_straightness_rms_px": 2.0
    },
    "warning": {
      "max_parallelism_deviation_deg": 1.20,
      "max_orthogonality_deviation_deg": 1.80,
      "max_straightness_rms_px": 4.0
    }
  }
}
