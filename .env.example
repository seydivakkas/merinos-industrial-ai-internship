# ==============================================================================
# MERINOS INDUSTRIAL AI PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=change-this-in-production-super-secret-key

# Redis & Celery Settings
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Qdrant Vector Database
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION_NAME=carpet_embeddings

# Storage & Model Cache Paths
MODEL_CACHE_DIR=./shared/models_cache
ARTIFACT_STORAGE_DIR=./shared/artifacts
SYNTHETIC_DATA_DIR=./shared/datasets

# Hardware / Compute Settings
CUDA_VISIBLE_DEVICES=0
TORCH_DTYPE=float16
ENABLE_XFORMERS=true
MAX_BATCH_SIZE=8
