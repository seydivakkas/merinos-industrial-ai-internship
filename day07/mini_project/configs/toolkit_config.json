{
  "project_name": "Merinos Industrial AI Internship - Day 07",
  "module": "OpenCV Image Analytics Toolkit",
  "version": "1.0.0",
  "supported_color_spaces": [
    "BGR",
    "RGB",
    "GRAY",
    "HSV",
    "LAB",
    "YCrCb"
  ],
  "default_target_size": [512, 512],
  "interpolation_methods": {
    "nearest": 0,
    "linear": 1,
    "cubic": 2,
    "area": 3,
    "lanczos4": 4
  },
  "filters": {
    "gaussian": {
      "ksize": [5, 5],
      "sigmaX": 1.5
    },
    "median": {
      "ksize": 5
    },
    "bilateral": {
      "d": 9,
      "sigmaColor": 75,
      "sigmaSpace": 75
    },
    "unsharp_mask": {
      "ksize": [5, 5],
      "sigma": 1.0,
      "strength": 1.5
    }
  },
  "clahe": {
    "clip_limit": 2.5,
    "tile_grid_size": [8, 8]
  },
  "analytics": {
    "histogram_bins": 256,
    "entropy_base": 2
  }
}
